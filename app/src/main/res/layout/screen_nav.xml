<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/screen_pad">

    <FrameLayout
        android:id="@+id/nav_map_tile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.65"
        android:background="@drawable/tile_bg">

        <com.thecarlauncher.views.MapTileView
            android:id="@+id/nav_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/nav_speed_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/tile_pad"
            android:background="@drawable/chip_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/nav_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/nav_speed_unit"
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nav_status"
            style="@style/Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp"
            android:text="@string/waiting_gps" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="@dimen/tile_pad"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_zoom_in"
                style="@style/IconButton"
                android:background="@drawable/chip_bg"
                android:src="@drawable/ic_add" />

            <ImageView
                android:id="@+id/nav_zoom_out"
                style="@style/IconButton"
                android:layout_marginTop="8dp"
                android:background="@drawable/chip_bg"
                android:src="@drawable/ic_remove" />

            <ImageView
                android:id="@+id/nav_recenter"
                style="@style/IconButton"
                android:layout_marginTop="8dp"
                android:background="@drawable/chip_bg"
                android:src="@drawable/ic_gps" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_margin="8dp"
            android:text="@string/map_attribution"
            android:textColor="@color/text_dim"
            android:textSize="9sp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/gap"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Destination search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tile_bg"
                android:orientation="vertical"
                android:padding="@dimen/tile_pad">

                <TextView
                    style="@style/Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/where_to" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/nav_query"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/field_bg"
                        android:drawableLeft="@drawable/ic_search"
                        android:drawablePadding="8dp"
                        android:hint="@string/where_to"
                        android:imeOptions="actionGo|flagNoExtractUi"
                        android:inputType="textPostalAddress"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_dim"
                        android:textCursorDrawable="@drawable/cursor"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/nav_go"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/go"
                        android:textColor="#FF041018"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Saved places -->
            <LinearLayout
                android:id="@+id/nav_places"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:background="@drawable/tile_bg"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <!-- Trip data -->
            <GridLayout
                android:id="@+id/nav_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:background="@drawable/tile_bg"
                android:columnCount="2"
                android:padding="@dimen/tile_pad" />

            <TextView
                android:id="@+id/nav_open_app"
                style="@style/Chip"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/gap"
                android:drawableLeft="@drawable/ic_navigation" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
