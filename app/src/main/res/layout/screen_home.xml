<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/screen_pad">

    <!-- Navigation tile -->
    <FrameLayout
        android:id="@+id/nav_tile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/gap"
        android:layout_weight="1.3"
        android:background="@drawable/tile_bg">

        <com.thecarlauncher.views.MapTileView
            android:id="@+id/home_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/tile_pad">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_navigation"
                android:tag="accent" />

            <TextView
                style="@style/Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:text="@string/navigation"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/home_nav_heading"
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_nav_status"
            style="@style/Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp"
            android:text="@string/waiting_gps" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/tile_pad">

            <TextView
                android:id="@+id/home_go_home"
                style="@style/Chip"
                android:drawableLeft="@drawable/ic_home"
                android:text="@string/home" />

            <TextView
                android:id="@+id/home_go_work"
                style="@style/Chip"
                android:layout_marginLeft="8dp"
                android:drawableLeft="@drawable/ic_work"
                android:text="@string/work" />

        </LinearLayout>

        <TextView
            android:id="@+id/home_map_attrib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="3dp"
            android:text="@string/map_attribution"
            android:textColor="@color/text_dim"
            android:textSize="9sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Media tile -->
        <LinearLayout
            android:id="@+id/media_tile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.15"
            android:background="@drawable/tile_bg"
            android:orientation="horizontal"
            android:padding="@dimen/tile_pad">

            <com.thecarlauncher.views.AlbumArtView
                android:id="@+id/home_art"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/tile_pad"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/home_media_src_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_music"
                        android:tag="accent" />

                    <TextView
                        android:id="@+id/home_media_src"
                        style="@style/Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/media"
                        android:tag="accent_text" />

                    <com.thecarlauncher.views.VisualizerView
                        android:id="@+id/home_viz"
                        android:layout_width="26dp"
                        android:layout_height="14dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/home_media_title"
                    style="@style/Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nothing_playing"
                    android:textSize="@dimen/home_title" />

                <TextView
                    android:id="@+id/home_media_artist"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tap_to_play" />

                <ProgressBar
                    android:id="@+id/home_media_progress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_thin" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/home_prev"
                        style="@style/IconButton"
                        android:layout_width="@dimen/home_icon_button"
                        android:layout_height="@dimen/home_icon_button"
                        android:padding="9dp"
                        android:src="@drawable/ic_prev" />

                    <ImageView
                        android:id="@+id/home_play"
                        android:layout_width="@dimen/home_play"
                        android:layout_height="@dimen/home_play"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_play" />

                    <ImageView
                        android:id="@+id/home_next"
                        style="@style/IconButton"
                        android:layout_width="@dimen/home_icon_button"
                        android:layout_height="@dimen/home_icon_button"
                        android:padding="9dp"
                        android:src="@drawable/ic_next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/gap"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Drive tile -->
            <FrameLayout
                android:id="@+id/drive_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tile_bg"
                android:padding="@dimen/tile_pad">

                <TextView
                    style="@style/Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/drive" />

                <com.thecarlauncher.views.SpeedGaugeView
                    android:id="@+id/home_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp" />
            </FrameLayout>

            <!-- Favourites tile -->
            <LinearLayout
                android:id="@+id/fav_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/gap"
                android:layout_weight="1"
                android:background="@drawable/tile_bg"
                android:orientation="vertical"
                android:padding="@dimen/tile_pad">

                <TextView
                    style="@style/Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favourites" />

                <GridLayout
                    android:id="@+id/fav_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:columnCount="2"
                    android:rowCount="2" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
